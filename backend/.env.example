# Copy to .env and fill in. Never commit .env.

# Django
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
DJANGO_SETTINGS_MODULE=config.settings.dev
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://chat:chat@localhost:5432/chat
CORS_ORIGIN=http://localhost:5173

# Tests use TEST_DATABASE_URL so a developer .env cannot point pytest at production.
TEST_DATABASE_URL=postgres://chat:chat@localhost:5432/chat

# Supabase. The service-role key stays on the server. It is never returned to clients.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Optional. Legacy projects sign access tokens with HS256 and this secret.
# Newer projects use asymmetric keys from the JWKS endpoint and can leave this empty.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUD=authenticated
SUPABASE_AVATAR_BUCKET=avatars
SUPABASE_ATTACHMENT_BUCKET=attachments

# Required in production so rate limits are shared across processes. Empty uses local memory.
REDIS_URL=

# Optional throttle overrides. Defaults match the API spec.
# THROTTLE_ANON=20/minute
# THROTTLE_USER=120/minute
# THROTTLE_AUTH_LOGIN=5/minute
# THROTTLE_AUTH_REGISTER=5/hour
# THROTTLE_AUTH_PASSWORD=3/hour
# THROTTLE_MESSAGE_SEND=30/minute
# THROTTLE_TYPING=60/minute
# THROTTLE_UPLOAD=10/minute
